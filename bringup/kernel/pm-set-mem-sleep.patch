Subject: [PATCH] PM: suspend: add pm_set_mem_sleep()

mt8183-usb-suspend-power.patch calls pm_set_mem_sleep() to switch
mem_sleep between s2idle and deep. The helper is not in mainline
6.18.28. Apply this patch first. It takes the system sleep lock and
sets mem_sleep_current, matching the 6.18.28-mt81-kukui2 kernel that
is already booting.

--- a/include/linux/suspend.h
+++ b/include/linux/suspend.h
@@ -153,6 +153,7 @@
  */
 extern void suspend_set_ops(const struct platform_suspend_ops *ops);
 extern int suspend_valid_only_mem(suspend_state_t state);
+extern void pm_set_mem_sleep(suspend_state_t state);
 
 extern unsigned int pm_suspend_global_flags;
 
@@ -290,6 +291,7 @@
 static inline bool pm_suspend_default_s2idle(void) { return false; }
 
 static inline void suspend_set_ops(const struct platform_suspend_ops *ops) {}
+static inline void pm_set_mem_sleep(suspend_state_t state) {}
 static inline int pm_suspend(suspend_state_t state) { return -ENOSYS; }
 static inline bool sync_on_suspend_enabled(void) { return true; }
 static inline bool idle_should_enter_s2idle(void) { return false; }
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -213,6 +213,21 @@
 }
 __setup("mem_sleep_default=", mem_sleep_default_setup);
 
+void pm_set_mem_sleep(suspend_state_t state)
+{
+	unsigned int sleep_flags;
+
+	if (state < PM_SUSPEND_TO_IDLE || state > PM_SUSPEND_MEM)
+		return;
+	if (!mem_sleep_states[state])
+		return;
+
+	sleep_flags = lock_system_sleep();
+	mem_sleep_current = state;
+	unlock_system_sleep(sleep_flags);
+}
+EXPORT_SYMBOL_GPL(pm_set_mem_sleep);
+
 /**
  * suspend_set_ops - Set the global suspend method table.
  * @ops: Suspend operations to use.
