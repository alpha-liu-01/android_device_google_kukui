Subject: [PATCH] PM: suspend: add pm_set_mem_sleep()

mt8183-usb-suspend-power.patch switches /sys/power/mem_sleep between
s2idle and deep when suspend_power_off changes, and calls this helper.
It is not in mainline. Apply this patch first.

--- a/include/linux/suspend.h
+++ b/include/linux/suspend.h
@@ -252,6 +252,7 @@
 }
 
 extern bool pm_suspend_default_s2idle(void);
+extern void pm_set_mem_sleep(suspend_state_t state);
 extern void __init pm_states_init(void);
 extern void s2idle_set_ops(const struct platform_s2idle_ops *ops);
 extern void s2idle_wake(void);
@@ -288,6 +289,7 @@
 static inline bool pm_resume_via_firmware(void) { return false; }
 static inline bool pm_suspend_no_platform(void) { return false; }
 static inline bool pm_suspend_default_s2idle(void) { return false; }
+static inline void pm_set_mem_sleep(suspend_state_t state) {}
 
 static inline void suspend_set_ops(const struct platform_suspend_ops *ops) {}
 static inline int pm_suspend(suspend_state_t state) { return -ENOSYS; }
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -74,6 +74,22 @@
 }
 EXPORT_SYMBOL_GPL(pm_suspend_default_s2idle);
 
+/**
+ * pm_set_mem_sleep - Select the state that "mem" suspends to.
+ * @state: PM_SUSPEND_TO_IDLE, PM_SUSPEND_STANDBY or PM_SUSPEND_MEM.
+ *
+ * Same effect as writing the matching label to /sys/power/mem_sleep. A
+ * state the platform does not offer is ignored.
+ */
+void pm_set_mem_sleep(suspend_state_t state)
+{
+	if (state <= PM_SUSPEND_ON || state >= PM_SUSPEND_MAX ||
+	    !mem_sleep_states[state])
+		return;
+	WRITE_ONCE(mem_sleep_current, state);
+}
+EXPORT_SYMBOL_GPL(pm_set_mem_sleep);
+
 void s2idle_set_ops(const struct platform_s2idle_ops *ops)
 {
 	unsigned int sleep_flags;
