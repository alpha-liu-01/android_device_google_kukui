+/*
+ * The MT8183 SCP firmware (ChromeOS ABI) fills the third img_mux field with
+ * the MMSYS instance the mux register belongs to (vpp_id), not a GCE subsys,
+ * and the register as an offset inside that MMSYS. Resolve it through the
+ * MMSYS node's mediatek,gce-client-reg. Other SoCs pass the subsys directly.
+ */
+static int mdp_mux_reg(struct mdp_path *path, const struct img_mux *set,
+		       u8 *subsys, u16 *offset)
+{
+	struct mdp_dev *mdp = path->mdp_dev;
+	struct cmdq_client_reg reg;
+	struct device *mmsys;
+	int ret;
+
+	*subsys = set->subsys_id;
+	*offset = set->reg;
+	if (!CFG_CHECK(MT8183, mdp->mdp_data->mdp_plat_id))
+		return 0;
+
+	if (set->subsys_id >= MDP_MM_SUBSYS_MAX)
+		return -EINVAL;
+	mmsys = mdp->mm_subsys[set->subsys_id].mmsys;
+	if (!mmsys)
+		return -ENODEV;
+	ret = cmdq_dev_get_client_reg(mmsys, &reg, 0);
+	if (ret)
+		return ret;
+	*subsys = reg.subsys;
+	*offset = reg.offset + set->reg;
+	return 0;
+}
+
 static int mdp_path_config_subfrm(struct mdp_cmdq_cmd *cmd,
 				  struct mdp_path *path, u32 count)
 {
@@ -300,6 +332,8 @@
 	const struct img_mux *set;
 	struct mdp_comp_ctx *ctx;
 	struct mdp_pipe_info pipe;
