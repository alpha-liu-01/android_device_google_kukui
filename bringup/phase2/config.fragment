# Phase 2 fragment, applied on top of the running 6.18.28-mt81 config.
# Symbols below were checked against linux-6.18.28 Kconfig before enabling.

CONFIG_LOCALVERSION="-mt81-kukui2"
CONFIG_EROFS_FS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_CPUSETS_V1=y
CONFIG_FS_ENCRYPTION=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_DM_VERITY=y
# netd's static iptables rules use these matches. They are modules so the
# running image does not need a new built-in config; ramdisk insmod loads them.
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_POLICY=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_U32=m
# Closing a PF_KEY socket calls synchronize_rcu(). Network stats use that
# to swap the bpf maps. Without it, socket(AF_KEY) returns EAFNOSUPPORT
# and system_server crash-loops on the boot animation.
CONFIG_NET_KEY=m
# CONFIG_NET_KEY_MIGRATE is not set
# netd opens NETLINK_NFLOG. The quota socket is allowed to fail, but the
# strict-socket unbind then returns EINVAL on every start.
CONFIG_NETFILTER_NETLINK_LOG=m
# CCI devfreq. mtk-svs needs the CCI OPP table for its third bank; without
# this driver it stays in deferred probe and no SVS voltages are applied.
CONFIG_ARM_MEDIATEK_CCI_DEVFREQ=y
# Suspend debugging. PM_SLEEP_DEBUG adds /sys/power/pm_wakeup_irq and
# pm_debug_messages, which name the wakeup source that aborts a suspend.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# Keep the kernel log of a crashed or hung boot. Coreboot already reserves
# a 1 MiB ramoops region in the DT; Android mounts /sys/fs/pstore.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# 128 KiB lost everything before about 7.7 s of an Android boot.
CONFIG_LOG_BUF_SHIFT=21
# Multi-generational LRU, and huge pages only where asked for, for 4 GiB
# with zram.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# The MT6358 RTC reads 60 years ahead (2086 instead of 2026). Loading
# rtc-mt6397 with HCTOSYS set the system clock to 2086. Android sets the
# time from the network anyway; the RTC is only needed for wake alarms.
# CONFIG_RTC_HCTOSYS is not set
# Boot log on the panel until the boot animation. 8x16 is about 2 mm high
# on this 1920x1200 10" panel; the command line picks TER16x32.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# Kernel BTF. The cputimeinstate BPF object (per-app CPU time in battery
# stats) reads task_struct->pid with a CO-RE relocation; without
# /sys/kernel/btf/vmlinux libbpf drops the whole object. Needs pahole
# (dwarves) on the build host. The DWARF stays in vmlinux; the Image only
# gains the .BTF section, and the modules keep theirs after strip-debug.
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
# Android destroys sockets of a network that went away (SOCK_DESTROY);
# without it system_server logs ENOTSUP for each one.
CONFIG_INET_DIAG_DESTROY=y
# =m because IPV6 is a module; udp_diag.ko is in the ramdisk.
CONFIG_INET_UDP_DIAG=m
# fs-verity for APK verity. userdata (f2fs) only uses it once it is
# formatted with the verity feature.
CONFIG_FS_VERITY=y
