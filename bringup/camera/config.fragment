CONFIG_MTK_CAMSV=m
CONFIG_MTK_SENINF30=m
CONFIG_VIDEO_OV8856=m
CONFIG_VIDEO_OV02A10=m
CONFIG_VIDEO_DW9768=m
CONFIG_PHY_MTK_MIPI_CSI_0_5=m
# libcamera allocates its buffers from /dev/dma_heap/system (the reserved
# heap is too small, docs/camera.md). Codec2 software codecs use it too.
CONFIG_DMABUF_HEAPS_SYSTEM=y
