diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_dispatch.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_dispatch.c
index 68cb362..9a11aeb 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_dispatch.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_dispatch.c
@@ -214,6 +214,68 @@ cmd_dispatch(struct panvk_cmd_buffer *cmdbuf, struct panvk_dispatch_info *info)
    clear_dirty_after_dispatch(cmdbuf);
 }
 
+#if PAN_ARCH <= 7
+/* The kernel job timeout is 500ms.  A Bifrost compute job that is still
+ * ACTIVE when that fires resets the GPU and the compositor's fragment job
+ * with it.  Geekbench completed at 16384 groups and 4 MiB threads (score
+ * 493).  Raising that to 32768 groups let a 60x1080 local-32 dispatch
+ * (64800 groups) run long enough to hit the timeout, and the score did not
+ * move.  Barriers are per workgroup.  gl_NumWorkGroups stays the original
+ * size; gl_WorkGroupID gets wg_base added by NIR.
+ */
+static void
+cmd_dispatch_sliced(struct panvk_cmd_buffer *cmdbuf, uint32_t base_x,
+                    uint32_t base_y, uint32_t base_z, uint32_t count_x,
+                    uint32_t count_y, uint32_t count_z, uint32_t full_x,
+                    uint32_t full_y, uint32_t full_z)
+{
+   const struct panvk_shader_variant *shader =
+      panvk_shader_only_variant(cmdbuf->state.compute.shader);
+   if (!shader)
+      return;
+
+   unsigned local = shader->cs.local_size.x * shader->cs.local_size.y *
+                    shader->cs.local_size.z;
+   uint32_t max_groups = 16384;
+   const uint64_t max_threads = 4ull << 20;
+
+   if (local && (uint64_t)max_groups * local > max_threads)
+      max_groups = MAX2((uint32_t)(max_threads / local), 1u);
+
+   uint64_t groups = (uint64_t)count_x * count_y * count_z;
+
+   if (groups <= max_groups || (count_x <= 1 && count_y <= 1 && count_z <= 1)) {
+      struct panvk_dispatch_info info = {
+         .wg_base = {base_x, base_y, base_z},
+         .direct.wg_count = {count_x, count_y, count_z},
+         .num_wg = {full_x, full_y, full_z},
+      };
+      cmd_dispatch(cmdbuf, &info);
+      return;
+   }
+
+   if (count_x >= count_y && count_x >= count_z) {
+      uint32_t mid = count_x / 2;
+      cmd_dispatch_sliced(cmdbuf, base_x, base_y, base_z, mid, count_y, count_z,
+                          full_x, full_y, full_z);
+      cmd_dispatch_sliced(cmdbuf, base_x + mid, base_y, base_z, count_x - mid,
+                          count_y, count_z, full_x, full_y, full_z);
+   } else if (count_y >= count_z) {
+      uint32_t mid = count_y / 2;
+      cmd_dispatch_sliced(cmdbuf, base_x, base_y, base_z, count_x, mid, count_z,
+                          full_x, full_y, full_z);
+      cmd_dispatch_sliced(cmdbuf, base_x, base_y + mid, base_z, count_x,
+                          count_y - mid, count_z, full_x, full_y, full_z);
+   } else {
+      uint32_t mid = count_z / 2;
+      cmd_dispatch_sliced(cmdbuf, base_x, base_y, base_z, count_x, count_y, mid,
+                          full_x, full_y, full_z);
+      cmd_dispatch_sliced(cmdbuf, base_x, base_y, base_z + mid, count_x, count_y,
+                          count_z - mid, full_x, full_y, full_z);
+   }
+}
+#endif
+
 VKAPI_ATTR void VKAPI_CALL
 panvk_per_arch(CmdDispatchBase)(VkCommandBuffer commandBuffer,
                                 uint32_t baseGroupX, uint32_t baseGroupY,
@@ -225,11 +287,17 @@ panvk_per_arch(CmdDispatchBase)(VkCommandBuffer commandBuffer,
    if (groupCountX == 0 || groupCountY == 0 || groupCountZ == 0)
       return;
 
+#if PAN_ARCH <= 7
+   cmd_dispatch_sliced(cmdbuf, baseGroupX, baseGroupY, baseGroupZ, groupCountX,
+                       groupCountY, groupCountZ, groupCountX, groupCountY,
+                       groupCountZ);
+#else
    struct panvk_dispatch_info info = {
       .wg_base = {baseGroupX, baseGroupY, baseGroupZ},
       .direct.wg_count = {groupCountX, groupCountY, groupCountZ},
    };
    cmd_dispatch(cmdbuf, &info);
+#endif
 }
 
 VKAPI_ATTR void VKAPI_CALL
