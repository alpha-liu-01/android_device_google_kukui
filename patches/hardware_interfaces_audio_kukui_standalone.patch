+void StreamAlsa::stopSilence() {
+    mSilenceRunning = false;
+    if (mSilenceThread.joinable()) mSilenceThread.join();
+}
+
+void StreamAlsa::silenceThread() {
+    const size_t frames = mBufferSizeFrames > 480 ? 480 : mBufferSizeFrames;
+    if (frames == 0 || mFrameSizeBytes == 0) return;
+    std::vector<uint8_t> silence(frames * mFrameSizeBytes, 0);
+    while (mSilenceRunning) {
+        bool wrote = false;
+        for (const auto& proxy : mAlsaDeviceProxies) {
+            if (!mSilenceRunning) return;
+            if (proxy_write_with_retries(proxy.get(), silence.data(), silence.size(),
+                                         mReadWriteRetries) == 0) {
+                wrote = true;
+            }
+        }
+        if (!wrote && mSilenceRunning) usleep(10000);
+    }
+}
