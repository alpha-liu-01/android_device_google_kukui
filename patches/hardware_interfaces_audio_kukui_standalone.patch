+ndk::ScopedAStatus ModulePrimary::populateConnectedDevicePort(AudioPort* audioPort, int32_t) {
+    // HDMI and the analog headset are declared with static profiles. The base
+    // implementation rejects every external device, so the DP jack never becomes
+    // an available output.
+    if (audioPort->ext.getTag() == AudioPortExt::device && !audioPort->profiles.empty()) {
+        LOG(DEBUG) << __func__ << ": keeping declared profiles for "
+                   << audioPort->ext.get<AudioPortExt::device>().device.toString();
+        return ndk::ScopedAStatus::ok();
+    }
+    return Module::populateConnectedDevicePort(audioPort, 0);
+}
+
+void ModulePrimary::onExternalDeviceConnectionChanged(const AudioPort& audioPort, bool connected) {
+    // The base callback does nothing. setConnectedDevices() only runs when a
+    // stream is reconfigured, so plugging the jack left Headphones Switch off
+    // and the codec stayed silent after the speaker path muted.
+    if (audioPort.ext.getTag() != AudioPortExt::device) {
+        return;
+    }
+    const auto& description = audioPort.ext.get<AudioPortExt::device>().device.type;
+    if (description.connection != AudioDeviceDescription::CONNECTION_ANALOG) {
+        return;
+    }
+    const bool isInput = description.type == AudioDeviceType::IN_HEADSET;
+    const bool isOutput = description.type == AudioDeviceType::OUT_HEADPHONE ||
+                          description.type == AudioDeviceType::OUT_HEADSET;
+    if (!kukuiAudioRoute()) return;
+    if (isOutput) {
+        configureKukuiOutput(connected);
+    }
+    if (isInput) {
+        configureKukuiInput(connected);
+    }
+}
+
 }  // namespace aidl::android::hardware::audio::core
