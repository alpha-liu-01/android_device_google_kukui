diff --git a/audio/aidl/default/include/core-impl/KukuiMixer.h b/audio/aidl/default/include/core-impl/KukuiMixer.h
new file mode 100644
index 0000000..96786f1
--- /dev/null
+++ b/audio/aidl/default/include/core-impl/KukuiMixer.h
@@ -0,0 +1,128 @@
+#pragma once
+
+extern "C" {
+#include <tinyalsa/asoundlib.h>
+}
+
+#include <cstdio>
+#include <fstream>
+#include <string>
+
+#include <android-base/logging.h>
+#include <android-base/properties.h>
+
+namespace aidl::android::hardware::audio::core {
+
+// Krane uses the MT6358 + MAX98357A card. Gru's DA7219 controls are absent.
+inline bool kukuiAudioRoute() {
+    static const bool enabled =
+            ::android::base::GetProperty("ro.vendor.audio.route", "") == "kukui";
+    return enabled;
+}
+
+// snd-usb-audio registers first when a DAC is already plugged in, so the
+// MT8183 card is not always card 0. The policy address stays CARD_0_DEV_*.
+inline int kukuiAlsaCard() {
+    static int cached = -1;
+    if (cached >= 0) return cached;
+    std::ifstream cards("/proc/asound/cards");
+    std::string line;
+    while (std::getline(cards, line)) {
+        if (line.find("mt8183mt6358") == std::string::npos &&
+            line.find("mt8183_mt6358") == std::string::npos) {
+            continue;
+        }
+        int card = -1;
+        if (sscanf(line.c_str(), " %d", &card) == 1 && card >= 0) {
+            cached = card;
+            LOG(INFO) << "kukui ALSA card " << card;
+            return card;
+        }
+    }
+    LOG(ERROR) << "kukui ALSA card not found";
+    return 0;
+}
+
+// Sequences match alsa-ucm-conf MediaTek/mt8183/mt8183_mt6358_ts3a227_max98357.
+// Speaker and the built-in mic are the Krane paths. The headphone and headset
+// mic sequences are the non-krane UCM block. This unit has no 3.5 mm jack, so
+// those two sequences are present for other kukui boards and are unverified.
+inline void configureKukuiOutput(bool headphone) {
+    struct mixer* mixer = mixer_open(kukuiAlsaCard());
+    if (mixer == nullptr) {
+        LOG(ERROR) << __func__ << ": mixer_open failed";
+        return;
+    }
+    auto setValues = [mixer](const char* name, int val) {
+        struct mixer_ctl* ctl = mixer_get_ctl_by_name(mixer, name);
+        if (ctl == nullptr) {
+            LOG(ERROR) << __func__ << ": missing " << name;
+            return;
+        }
+        const unsigned count = mixer_ctl_get_num_values(ctl);
+        for (unsigned i = 0; i < count; ++i) {
+            if (mixer_ctl_set_value(ctl, i, val) != 0) {
+                LOG(ERROR) << __func__ << ": set " << name << " failed";
+                return;
+            }
+        }
+    };
+    if (headphone) {
+        setValues("I2S3_CH1 DL1_CH1", 0);
+        setValues("I2S3_CH2 DL1_CH2", 0);
+        setValues("ADDA_DL_CH1 DL1_CH1", 1);
+        setValues("ADDA_DL_CH2 DL1_CH2", 1);
+        setValues("HPL Mux", 2);
+        setValues("HPR Mux", 2);
+    } else {
+        setValues("ADDA_DL_CH1 DL1_CH1", 0);
+        setValues("ADDA_DL_CH2 DL1_CH2", 0);
+        setValues("HPL Mux", 0);
+        setValues("HPR Mux", 0);
+        setValues("I2S3_CH1 DL1_CH1", 1);
+        setValues("I2S3_CH2 DL1_CH2", 1);
+    }
+    mixer_close(mixer);
+}
+
+inline void configureKukuiInput(bool headsetMic) {
+    struct mixer* mixer = mixer_open(kukuiAlsaCard());
+    if (mixer == nullptr) {
+        LOG(ERROR) << __func__ << ": mixer_open failed";
+        return;
+    }
+    auto setValues = [mixer](const char* name, int val) {
+        struct mixer_ctl* ctl = mixer_get_ctl_by_name(mixer, name);
+        if (ctl == nullptr) {
+            LOG(ERROR) << __func__ << ": missing " << name;
+            return;
+        }
+        const unsigned count = mixer_ctl_get_num_values(ctl);
+        for (unsigned i = 0; i < count; ++i) {
+            if (mixer_ctl_set_value(ctl, i, val) != 0) {
+                LOG(ERROR) << __func__ << ": set " << name << " failed";
+                return;
+            }
+        }
+    };
+    if (headsetMic) {
+        setValues("MTKAIF_DMIC", 0);
+        setValues("UL3_CH2 ADDA_UL_CH2", 0);
+        setValues("PGA L Mux", 2);
+        setValues("ADC L Mux", 2);
+        setValues("Mic Type Mux", 1);
+        setValues("PGA Volume", 4);
+        setValues("UL3_CH1 ADDA_UL_CH1", 1);
+    } else {
+        setValues("PGA L Mux", 0);
+        setValues("ADC L Mux", 0);
+        setValues("PGA Volume", 0);
+        setValues("MTKAIF_DMIC", 1);
+        setValues("Mic Type Mux", 2);
+        setValues("UL3_CH1 ADDA_UL_CH1", 1);
+        setValues("UL3_CH2 ADDA_UL_CH2", 1);
+    }
+    mixer_close(mixer);
+}
+
+}  // namespace aidl::android::hardware::audio::core
