new file mode 100644
index 0000000..a4a2aca
--- /dev/null
+++ b/ffi/src/lib.rs
@@ -0,0 +1,504 @@
+// Copyright 2026 The LineageOS Project
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! C interface to the cros-codecs V4L2 stateless decoders. See `include/cros_codecs_ffi.h`.
+
+use std::ffi::c_void;
+use std::fmt;
+use std::fs::File;
+use std::os::fd::FromRawFd;
+use std::panic::catch_unwind;
+use std::panic::AssertUnwindSafe;
+use std::sync::Arc;
+
+use cros_codecs::backend::v4l2::decoder::stateless::V4l2StatelessDecoderBackend;
+use cros_codecs::decoder::stateless::h264::H264;
+use cros_codecs::decoder::stateless::vp8::Vp8;
+use cros_codecs::decoder::stateless::vp9::Vp9;
+use cros_codecs::decoder::stateless::DecodeError;
+use cros_codecs::decoder::stateless::DynStatelessVideoDecoder;
+use cros_codecs::decoder::stateless::StatelessDecoder;
+use cros_codecs::decoder::stateless::StatelessVideoDecoder;
+use cros_codecs::decoder::BlockingMode;
+use cros_codecs::decoder::DecodedHandle;
+use cros_codecs::decoder::DecoderEvent;
+use cros_codecs::decoder::DynDecodedHandle;
+use cros_codecs::decoder::ReadyFrame;
+use cros_codecs::decoder::StreamInfo;
+use cros_codecs::image_processing::convert_video_frame;
+use cros_codecs::video_frame::generic_dma_video_frame::GenericDmaVideoFrame;
+use cros_codecs::video_frame::v4l2_mmap_video_frame::V4l2MmapVideoFrame;
+use cros_codecs::DecodedFormat;
+use cros_codecs::Fourcc;
+use cros_codecs::FrameLayout;
+use cros_codecs::PlaneLayout;
+use cros_codecs::Rect;
+use cros_codecs::Resolution;
+
+const CC_CODEC_H264: u32 = 0;
+const CC_CODEC_VP8: u32 = 1;
+const CC_CODEC_VP9: u32 = 2;
+
+const CC_STATUS_OK: i32 = 0;
+#[allow(dead_code)]
+const CC_STATUS_NEED_FRAMES: i32 = 1;
+const CC_STATUS_CHECK_EVENTS: i32 = 2;
+const CC_STATUS_OUT_OF_SLOTS: i32 = 3;
+const CC_STATUS_ERROR: i32 = -1;
+
+const CC_EVENT_FRAME: u32 = 1;
+const CC_EVENT_FORMAT_CHANGED: u32 = 2;
+const CC_EVENT_CSD: u32 = 3;
+// A decoded frame is waiting for a client buffer. The caller must fetch one and call next_event
+// again. The frame stays queued here.
+const CC_EVENT_NEED_OUTPUT: u32 = 4;
+
+const CC_MAX_PLANES: usize = 4;
+
+/// Output buffer description, mirrors `CcFrameDesc` in `cros_codecs_ffi.h`.
+#[repr(C)]
+#[derive(Default)]
+pub struct CcFrameDesc {
+    token: u64,
+    fd: i32,
+    fourcc: u32,
+    width: u32,
+    height: u32,
+    num_planes: u32,
+    offsets: [u64; CC_MAX_PLANES],
+    strides: [u64; CC_MAX_PLANES],
+}
+
+/// Decoder event, mirrors `CcEvent` in `cros_codecs_ffi.h`.
+#[repr(C)]
+#[derive(Default)]
+pub struct CcEvent {
+    type_: u32,
+    timestamp: u64,
+    token: u64,
+    visible_left: u32,
+    visible_top: u32,
+    visible_right: u32,
+    visible_bottom: u32,
+    coded_width: u32,
+    coded_height: u32,
+    min_num_frames: u32,
+    fourcc: u32,
+}
+
+/// Fills the descriptor with a free output buffer, or returns false if none is available.
+pub type CcAllocFrameCb = extern "C" fn(ctx: *mut c_void, desc: *mut CcFrameDesc) -> bool;
+/// Notifies the client that the decoder no longer references a buffer.
+pub type CcReleaseFrameCb = extern "C" fn(ctx: *mut c_void, token: u64);
+
+struct TokenInner {
+    id: u64,
+    ctx: usize,
+    release_cb: CcReleaseFrameCb,
+}
+
+impl Drop for TokenInner {
+    fn drop(&mut self) {
+        (self.release_cb)(self.ctx as *mut c_void, self.id);
+    }
+}
+
+/// Identifies a client buffer. The client is notified when the last clone is dropped.
+#[derive(Clone)]
+pub struct FrameToken(Arc<TokenInner>);
+
+impl fmt::Debug for FrameToken {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "FrameToken({})", self.0.id)
+    }
+}
+
+impl FrameToken {
+    fn id(&self) -> u64 {
+        self.0.id
+    }
+}
+
+// The decoder writes into driver-owned mmap buffers. MT8183's capture format is MM21, two
+// planes, and the stateless driver programs each plane from that plane's own dma-buf address.
+// It does not add data_offset, so one gralloc fd cannot be both the Y and the UV plane.
+type HwFrame = V4l2MmapVideoFrame;
+type Backend = V4l2StatelessDecoderBackend<HwFrame>;
+type ClientFrame = GenericDmaVideoFrame<FrameToken>;
+
+/// Decoder instance behind the opaque `CrosCodecsDecoder` C type.
+pub struct CrosCodecsDecoder {
+    decoder: DynStatelessVideoDecoder<HwFrame>,
+    ctx: usize,
+    alloc_cb: CcAllocFrameCb,
+    release_cb: CcReleaseFrameCb,
+    // Client buffers filled by the last next_event() calls. Dropping one releases it back to
+    // the client, so they stay here until the next decode() call.
+    emitted: Vec<ClientFrame>,
+    // A decoded frame that could not be copied yet because the client had no free buffer.
+    // Dropping it would discard the picture, so it stays until a buffer arrives or flush().
+    pending: Option<DynDecodedHandle<HwFrame>>,
+    // Set around flush. Pictures already in the decoder belong to the abandoned works and are
+    // dropped here, without the MM21 copy.
+    discard: bool,
+}
+
+fn set_rect(event: &mut CcEvent, rect: Rect) {
+    // cros-codecs stores the bottom-right corner in `width` and `height`.
+    event.visible_left = rect.x;
+    event.visible_top = rect.y;
+    event.visible_right = rect.width;
+    event.visible_bottom = rect.height;
+}
+
+impl CrosCodecsDecoder {
+    fn new(
+        codec: u32,
+        ctx: usize,
+        alloc_cb: CcAllocFrameCb,
+        release_cb: CcReleaseFrameCb,
+    ) -> Result<Self, String> {
+        let mode = BlockingMode::Blocking;
+        let decoder: DynStatelessVideoDecoder<HwFrame> = match codec {
+            CC_CODEC_H264 => StatelessDecoder::<H264, Backend>::new_v4l2(mode)
+                .map_err(|e| e.to_string())?
+                .into_trait_object(),
+            CC_CODEC_VP8 => StatelessDecoder::<Vp8, Backend>::new_v4l2(mode)
+                .map_err(|e| e.to_string())?
+                .into_trait_object(),
+            CC_CODEC_VP9 => StatelessDecoder::<Vp9, Backend>::new_v4l2(mode)
+                .map_err(|e| e.to_string())?
+                .into_trait_object(),
+            _ => return Err(format!("unsupported codec {codec}")),
+        };
+        Ok(Self {
+            decoder,
+            ctx,
+            alloc_cb,
+            release_cb,
+            emitted: Vec::new(),
+            pending: None,
+            discard: false,
+        })
+    }
+
+    fn decode(
+        &mut self,
+        timestamp: u64,
+        bitstream: &[u8],
+        offset: usize,
+        codec_specific_data: bool,
+        consumed: &mut usize,
+    ) -> i32 {
+        self.emitted.clear();
+
+        let picture = self.decoder.stream_info().cloned();
+        let mut alloc = || -> Option<HwFrame> {
+            let info = picture.as_ref()?;
+            Some(V4l2MmapVideoFrame::new(Fourcc::from(info.format), visible_size(info)))
+        };
+
+        let result = self.decoder.decode(
+            timestamp,
+            bitstream,
+            offset,
+            codec_specific_data,
+            &None,
+            &Vec::new(),
+            &mut alloc,
+        );
+        match result {
+            Ok((bytes, _)) => {
+                *consumed = bytes;
+                CC_STATUS_OK
+            }
+            Err(DecodeError::NotEnoughOutputBuffers(_)) => CC_STATUS_OUT_OF_SLOTS,
+            Err(DecodeError::CheckEvents) => CC_STATUS_CHECK_EVENTS,
+            Err(e) => {
+                log::error!("Decode error: {e:?}");
+                CC_STATUS_ERROR
+            }
+        }
+    }
+
+    fn drop_pending(&mut self) {
+        self.pending = None;
+    }
+
+    fn set_discard(&mut self, discard: bool) {
+        self.discard = discard;
+        if discard {
+            self.pending = None;
+        }
+    }
+
+    // Drops every picture the decoder has already queued. Used while flushing, so a 1080p
+    // detile does not run for frames the client is about to abandon.
+    fn discard_queued(&mut self) {
+        self.pending = None;
+        while let Some(event) = self.decoder.next_event() {
+            match event {
+                DecoderEvent::FrameReady(ReadyFrame::Frame(handle)) => drop(handle),
+                DecoderEvent::FrameReady(ReadyFrame::CSD(_)) | DecoderEvent::FormatChanged => {}
+            }
+        }
+    }
+
+    fn flush(&mut self) -> i32 {
+        self.emitted.clear();
+        self.pending = None;
+        match self.decoder.flush() {
+            Ok(()) => CC_STATUS_OK,
+            Err(e) => {
+                log::error!("Flush error: {e:?}");
+                CC_STATUS_ERROR
+            }
+        }
+    }
+
+    // Copies |handle| into a client buffer. If none is free, keeps |handle| and asks the
+    // caller to fetch one. Returning without the handle would drop the picture.
+    fn emit_frame(&mut self, handle: DynDecodedHandle<HwFrame>, event: &mut CcEvent) -> bool {
+        if let Err(e) = handle.sync() {
+            log::error!("Failed to sync decoded frame: {e:?}");
+        }
+        let hw = handle.video_frame();
+        let mut client = match self.take_client_frame() {
+            Some(frame) => frame,
+            None => {
+                self.pending = Some(handle);
+                event.type_ = CC_EVENT_NEED_OUTPUT;
+                return true;
+            }
+        };
+        if let Err(e) = convert_video_frame(hw.as_ref(), &mut client) {
+            log::error!("Failed to convert decoded frame to NV12: {e}");
+            return false;
+        }
+        event.type_ = CC_EVENT_FRAME;
+        // V4L2 backends store `timestamp << 1` and use the LSB to tell apart the frames
+        // of a VP9 superframe.
+        event.timestamp = handle.timestamp() >> 1;
+        event.token = client.token.id();
+        set_rect(event, handle.display_rect());
+        self.emitted.push(client);
+        true
+    }
+
+    fn next_event(&mut self, event: &mut CcEvent) -> bool {
+        *event = CcEvent::default();
+        if self.discard {
+            self.discard_queued();
+            return false;
+        }
+        if let Some(handle) = self.pending.take() {
+            return self.emit_frame(handle, event);
+        }
+        match self.decoder.next_event() {
+            Some(DecoderEvent::FrameReady(ReadyFrame::Frame(handle))) => {
+                self.emit_frame(handle, event)
+            }
+            Some(DecoderEvent::FrameReady(ReadyFrame::CSD(timestamp))) => {
+                event.type_ = CC_EVENT_CSD;
+                event.timestamp = timestamp;
+                true
+            }
+            Some(DecoderEvent::FormatChanged) => {
+                event.type_ = CC_EVENT_FORMAT_CHANGED;
+                if let Some(info) = self.decoder.stream_info() {
+                    event.coded_width = info.coded_resolution.width;
+                    event.coded_height = info.coded_resolution.height;
+                    event.min_num_frames = info.min_num_frames as u32;
+                    // The client buffer is linear NV12. MM21 is detiled in next_event before
+                    // the frame is handed over.
+                    let presented = match info.format {
+                        DecodedFormat::MM21 | DecodedFormat::NV12 => DecodedFormat::NV12,
+                        other => other,
+                    };
+                    event.fourcc = u32::from(Fourcc::from(presented));
+                    set_rect(event, info.display_rect);
+                }
+                true
+            }
+            None => false,
+        }
+    }
+
+    fn take_client_frame(&self) -> Option<ClientFrame> {
+        let mut desc = CcFrameDesc { fd: -1, ..Default::default() };
+        if !(self.alloc_cb)(self.ctx as *mut c_void, &mut desc) {
+            return None;
+        }
+        // SAFETY: the client transfers ownership of a valid dma-buf fd.
+        let file = unsafe { File::from_raw_fd(desc.fd) };
+        let token = FrameToken(Arc::new(TokenInner {
+            id: desc.token,
+            ctx: self.ctx,
+            release_cb: self.release_cb,
+        }));
+        let num_planes = (desc.num_planes as usize).min(CC_MAX_PLANES);
+        let layout = FrameLayout {
+            format: (Fourcc::from(desc.fourcc), 0),
+            size: Resolution { width: desc.width, height: desc.height },
+            planes: (0..num_planes)
+                .map(|i| PlaneLayout {
+                    buffer_index: 0,
+                    offset: desc.offsets[i] as usize,
+                    stride: desc.strides[i] as usize,
+                })
+                .collect(),
+        };
+        let rect = Rect { x: 0, y: 0, width: desc.width, height: desc.height };
+        match GenericDmaVideoFrame::new(token, vec![file], layout, rect) {
+            Ok(frame) => Some(frame),
+            Err(e) => {
+                log::error!("Invalid output buffer {}: {}", desc.token, e);
+                None
+            }
+        }
+    }
+}
+
+fn visible_size(info: &StreamInfo) -> Rect {
+    if info.display_rect.width > info.display_rect.x
+        && info.display_rect.height > info.display_rect.y
+    {
+        Rect {
+            x: 0,
+            y: 0,
+            width: info.display_rect.width - info.display_rect.x,
+            height: info.display_rect.height - info.display_rect.y,
+        }
+    } else {
+        Rect::from(info.coded_resolution)
+    }
+}
+
+fn guard<T>(default: T, f: impl FnOnce() -> T) -> T {
+    catch_unwind(AssertUnwindSafe(f)).unwrap_or_else(|_| {
+        log::error!("Panic in cros-codecs decoder");
+        default
+    })
+}
+
+/// # Safety
+///
+/// `ctx` must remain valid for as long as the callbacks can be invoked, i.e. until
+/// `cros_codecs_decoder_destroy()` returns.
+#[no_mangle]
+pub unsafe extern "C" fn cros_codecs_decoder_create(
+    codec: u32,
+    ctx: *mut c_void,
+    alloc_cb: CcAllocFrameCb,
+    release_cb: CcReleaseFrameCb,
+) -> *mut CrosCodecsDecoder {
+    android_logger::init_once(
+        android_logger::Config::default()
+            .with_max_level(log::LevelFilter::Info)
+            .with_tag("cros-codecs"),
+    );
+    guard(std::ptr::null_mut(), || {
+        match CrosCodecsDecoder::new(codec, ctx as usize, alloc_cb, release_cb) {
+            Ok(decoder) => Box::into_raw(Box::new(decoder)),
+            Err(e) => {
+                log::error!("Failed to create decoder: {e}");
+                std::ptr::null_mut()
+            }
+        }
+    })
+}
+
+/// # Safety
+///
+/// `decoder` must have been returned by `cros_codecs_decoder_create()` and not destroyed yet.
+#[no_mangle]
+pub unsafe extern "C" fn cros_codecs_decoder_destroy(decoder: *mut CrosCodecsDecoder) {
+    if !decoder.is_null() {
+        // SAFETY: the caller guarantees `decoder` came from `cros_codecs_decoder_create()`.
+        guard((), || drop(unsafe { Box::from_raw(decoder) }));
+    }
+}
+
+/// # Safety
+///
+/// `decoder` must be valid, `data` must point to `size` readable bytes and `consumed` must be
+/// writable.
+#[no_mangle]
+pub unsafe extern "C" fn cros_codecs_decoder_decode(
+    decoder: *mut CrosCodecsDecoder,
+    timestamp: u64,
+    data: *const u8,
+    size: usize,
+    offset: usize,
+    codec_specific_data: bool,
+    consumed: *mut usize,
+) -> i32 {
+    if decoder.is_null() || data.is_null() || consumed.is_null() || offset > size {
+        return CC_STATUS_ERROR;
+    }
+    // SAFETY: the caller guarantees the pointers are valid and `data` holds `size` bytes.
+    let (decoder, bitstream, consumed) =
+        unsafe { (&mut *decoder, std::slice::from_raw_parts(data, size), &mut *consumed) };
+    guard(CC_STATUS_ERROR, || {
+        decoder.decode(timestamp, bitstream, offset, codec_specific_data, consumed)
+    })
+}
+
+/// # Safety
+///
+/// `decoder` must be valid.
+#[no_mangle]
+pub unsafe extern "C" fn cros_codecs_decoder_flush(decoder: *mut CrosCodecsDecoder) -> i32 {
+    if decoder.is_null() {
+        return CC_STATUS_ERROR;
+    }
+    // SAFETY: the caller guarantees `decoder` is valid.
+    let decoder = unsafe { &mut *decoder };
+    guard(CC_STATUS_ERROR, || decoder.flush())
+}
+
+/// # Safety
+///
+/// `decoder` must be valid.
+#[no_mangle]
+pub unsafe extern "C" fn cros_codecs_decoder_set_discard(
+    decoder: *mut CrosCodecsDecoder,
+    discard: bool,
+) {
+    if decoder.is_null() {
+        return;
+    }
+    // SAFETY: the caller guarantees `decoder` is valid.
+    let decoder = unsafe { &mut *decoder };
+    guard((), || decoder.set_discard(discard));
+}
+
+/// # Safety
+///
+/// `decoder` must be valid.
+#[no_mangle]
+pub unsafe extern "C" fn cros_codecs_decoder_drop_pending(decoder: *mut CrosCodecsDecoder) {
+    if decoder.is_null() {
+        return;
+    }
+    // SAFETY: the caller guarantees `decoder` is valid.
+    let decoder = unsafe { &mut *decoder };
+    guard((), || decoder.drop_pending());
+}
+
+/// # Safety
+///
+/// `decoder` must be valid and `event` must be writable.
+#[no_mangle]
+pub unsafe extern "C" fn cros_codecs_decoder_next_event(
+    decoder: *mut CrosCodecsDecoder,
+    event: *mut CcEvent,
+) -> bool {
+    if decoder.is_null() || event.is_null() {
+        return false;
+    }
+    // SAFETY: the caller guarantees both pointers are valid.
+    let (decoder, event) = unsafe { (&mut *decoder, &mut *event) };
+    guard(false, || decoder.next_event(event))
+}
