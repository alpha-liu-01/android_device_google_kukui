+    /// Block until `flags` is reported for the video device, or `deadline` passes.
+    /// A capture buffer wakes `POLLIN`. An output buffer wakes `POLLOUT`.
+    fn wait_for(&self, flags: PollFlags, deadline: Instant) {
+        loop {
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                panic!("timed out waiting for a v4l2 buffer");
+            }
+            let mut fds = [PollFd::new(self.video_device.as_fd(), flags)];
+            let timeout = PollTimeout::try_from(remaining).expect("v4l2 poll timeout");
+            match poll(&mut fds, timeout) {
+                Ok(0) => panic!("timed out waiting for a v4l2 buffer"),
+                Ok(_) => {
+                    let revents = fds[0].revents().unwrap_or(PollFlags::empty());
+                    if revents.intersects(flags) {
+                        return;
+                    }
+                    if revents.intersects(PollFlags::POLLERR | PollFlags::POLLHUP | PollFlags::POLLNVAL)
