+}
+
+/// Same as [`reqbufs`], with `v4l2_requestbuffers.flags` set.
+pub fn reqbufs_flags<O: From<v4l2_requestbuffers>>(
+    fd: &impl AsRawFd,
+    queue: QueueType,
+    memory: MemoryType,
+    count: u32,
+    flags: u8,
 ) -> Result<O, ReqbufsError> {
     let mut reqbufs = v4l2_requestbuffers {
         count,
         type_: queue as u32,
         memory: memory as u32,
