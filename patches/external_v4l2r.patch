+/// Ask vb2 for CPU-cached MMAP buffers. The queue must advertise cache hints.
+/// DQBUF invalidates the cache before userspace reads a device-written buffer.
+pub const V4L2_MEMORY_FLAG_NON_COHERENT: u8 = 1;
+
