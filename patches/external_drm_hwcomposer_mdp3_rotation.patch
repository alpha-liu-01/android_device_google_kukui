+auto Mdp3Rotator::Create(DrmDevice &drm, std::function<void()> refresh)
+    -> std::unique_ptr<Mdp3Rotator> {
+  if (!Properties::Mdp3Rotation()) {
+    return {};
+  }
+  auto path = FindMdp3Node();
+  if (path.empty()) {
+    ALOGI("MDP3 rotation: no %s device", kMdp3Name);
+    return {};
+  }
+  auto fd = MakeUniqueFd(open(path.c_str(), O_RDWR | O_CLOEXEC));
+  if (!fd) {
+    ALOGE("MDP3 rotation: cannot open %s: %s", path.c_str(), strerror(errno));
+    return {};
+  }
+  struct v4l2_capability cap {};
+  if (Xioctl(*fd, VIDIOC_QUERYCAP, &cap) != 0 ||
+      (cap.device_caps & V4L2_CAP_VIDEO_M2M_MPLANE) == 0) {
+    ALOGE("MDP3 rotation: %s is not an m2m device", path.c_str());
+    return {};
+  }
+  ALOGI("MDP3 rotation: using %s", path.c_str());
+  // NOLINTNEXTLINE(cppcoreguidelines-owning-memory): private constructor
+  return std::unique_ptr<Mdp3Rotator>(
+      new Mdp3Rotator(drm, path, std::move(refresh)));
+}
+
+Mdp3Rotator::Mdp3Rotator(DrmDevice &drm, std::string path,
+                         std::function<void()> refresh)
+    : drm_(drm), path_(std::move(path)), refresh_(std::move(refresh)) {
+  worker_ = std::thread([this] { WorkerLoop(); });
+}
+
+Mdp3Rotator::~Mdp3Rotator() {
+  {
+    const std::lock_guard lock(mutex_);
+    stop_ = true;
+  }
+  cv_.notify_all();
+  worker_.join();
+}
+
+auto Mdp3Rotator::SameSource(const LayerData &layer,
+                             const std::shared_ptr<DrmFbIdHandle> &fb,
+                             const SharedFd &fence) -> bool {
+  return fb && layer.fb.get() == fb.get() &&
+         layer.acquire_fence.get() == fence.get();
+}
+
+/* LayerTransform flips first, then rotates clockwise. */
+auto Mdp3Rotator::Rotation(const LayerTransform &t) -> int {
+  if (!t.rotate90) {
+    return 0;
+  }
+  if (!t.hflip && !t.vflip) {
+    return 90;
+  }
+  if (t.hflip && t.vflip) {
+    return 270;
+  }
+  return -1;
+}
+
+auto Mdp3Rotator::RotatedInfo(const LayerData &layer, int rotation)
+    -> PresentInfo {
+  PresentInfo pi = layer.pi;
+  pi.transform = {};
+  pi.damage = {};
+  if (pi.source_crop.f_rect) {
+    const auto c = *pi.source_crop.f_rect;
+    const auto w = float(layer.bi->width);
+    const auto h = float(layer.bi->height);
+    SrcRectInfo::FRect r{};
+    if (rotation == 90) {
+      /* (x, y) -> (h - y, x) */
+      r = {h - c.bottom, c.left, h - c.top, c.right};
+    } else {
+      /* (x, y) -> (y, w - x) */
+      r = {c.top, w - c.right, c.bottom, w - c.left};
+    }
+    pi.source_crop.f_rect = r;
+  }
+  return pi;
+}
+
+auto Mdp3Rotator::Accepts(const LayerData &layer) const -> bool {
+  if (disabled_ || !layer.bi || !layer.fb) {
+    return false;
+  }
+  const auto &bi = *layer.bi;
+  const int rotation = Rotation(layer.pi.transform);
+  if (rotation != 90 && rotation != 270) {
+    return false;
+  }
+  /* MDP3 moves 32-bit pixels unchanged when told both sides are ARGB32, so
+   * any 4-byte RGB layout works. */
+  switch (bi.format) {
+    case DRM_FORMAT_ARGB8888:
+    case DRM_FORMAT_XRGB8888:
+    case DRM_FORMAT_ABGR8888:
+    case DRM_FORMAT_XBGR8888:
+      break;
+    default:
+      return false;
+  }
+  if (bi.modifiers[0] != DRM_FORMAT_MOD_NONE &&
+      bi.modifiers[0] != DRM_FORMAT_MOD_INVALID) {
+    return false;
+  }
+  if (bi.prime_fds[0] < 0 || bi.offsets[0] != 0) {
+    return false;
+  }
+  if (bi.width < kMinSize || bi.height < kMinSize || bi.width > kMaxSize ||
+      bi.height > kMaxSize || bi.pitches[0] < bi.width * 4) {
+    return false;
+  }
+  /* The planes cannot scale either, so only take layers that are 1:1 once
+   * rotated. */
+  return !RotatedInfo(layer, rotation).RequireScalingOrPhasing();
+}
+
+auto Mdp3Rotator::AllocTarget(Target &t, uint32_t width, uint32_t height,
+                              uint32_t format) -> bool {
+  const int drm_fd = *drm_.GetFd();
+  struct drm_mode_create_dumb create {};
+  create.width = width;
+  create.height = height;
+  create.bpp = 32;
+  if (drmIoctl(drm_fd, DRM_IOCTL_MODE_CREATE_DUMB, &create) != 0) {
+    ALOGE("MDP3 rotation: dumb buffer %ux%u: %s", width, height,
+          strerror(errno));
+    return false;
+  }
+  int prime = -1;
+  const int err = drmPrimeHandleToFD(drm_fd, create.handle,
+                                     DRM_CLOEXEC | DRM_RDWR, &prime);
+  /* The dmabuf keeps the buffer. The FB importer takes its own handle and
+   * closes it when the FB goes, so ours must not linger. */
+  struct drm_mode_destroy_dumb destroy {};
+  destroy.handle = create.handle;
+  drmIoctl(drm_fd, DRM_IOCTL_MODE_DESTROY_DUMB, &destroy);
+  if (err != 0) {
+    ALOGE("MDP3 rotation: export dumb buffer: %s", strerror(errno));
+    return false;
+  }
+
+  t.prime = MakeUniqueFd(prime);
+  t.bi = {};
+  t.bi.width = width;
+  t.bi.height = height;
+  t.bi.format = format;
+  t.bi.pitches[0] = create.pitch;
+  t.bi.sizes[0] = uint32_t(create.size);
+  for (int i = 0; i < kBufferMaxPlanes; i++) {
+    t.bi.prime_fds[i] = i == 0 ? prime : -1;
+    t.bi.modifiers[i] = DRM_FORMAT_MOD_NONE;
+  }
+  t.fb = drm_.GetDrmFbImporter().GetOrCreateFbId(&t.bi);
+  if (!t.fb) {
+    ALOGE("MDP3 rotation: cannot import %ux%u target", width, height);
+    return false;
+  }
+  return true;
+}
+
+auto Mdp3Rotator::Configure(State &st, const Config &cfg) -> bool {
+  ATRACE_NAME("MDP3 configure");
+  const uint32_t out_w = cfg.height;
+  const uint32_t out_h = cfg.width;
+
+  /* A new open() is a new m2m context, so the old one is dropped whole. */
+  st.video = MakeUniqueFd(-1);
+  st.shown = -1;
+  st.next = 0;
+  st.shown_fb.reset();
+  st.shown_fence.reset();
+
+  const bool same_targets = st.config && st.config->width == cfg.width &&
+                            st.config->height == cfg.height &&
+                            st.config->format == cfg.format &&
+                            st.targets[0].fb;
+  st.config.reset();
+  if (!same_targets) {
+    for (auto &t : st.targets) {
+      t = Target{};
+      if (!AllocTarget(t, out_w, out_h, cfg.format)) {
+        return false;
+      }
+    }
+  }
+
+  st.video = MakeUniqueFd(open(path_.c_str(), O_RDWR | O_CLOEXEC | O_NONBLOCK));
+  if (!st.video) {
+    ALOGE("MDP3 rotation: open %s: %s", path_.c_str(), strerror(errno));
+    return false;
+  }
+  const int fd = *st.video;
+
+  auto set_format = [fd](uint32_t type, uint32_t w, uint32_t h,
+                         uint32_t pitch) -> bool {
+    struct v4l2_format f {};
+    f.type = type;
+    f.fmt.pix_mp.width = w;
+    f.fmt.pix_mp.height = h;
+    f.fmt.pix_mp.pixelformat = V4L2_PIX_FMT_ARGB32;
+    f.fmt.pix_mp.field = V4L2_FIELD_NONE;
+    f.fmt.pix_mp.num_planes = 1;
+    f.fmt.pix_mp.plane_fmt[0].bytesperline = pitch;
+    if (Xioctl(fd, VIDIOC_S_FMT, &f) != 0) {
+      ALOGE("MDP3 rotation: S_FMT %ux%u: %s", w, h, strerror(errno));
+      return false;
+    }
+    if (f.fmt.pix_mp.width != w || f.fmt.pix_mp.height != h ||
+        f.fmt.pix_mp.pixelformat != V4L2_PIX_FMT_ARGB32 ||
+        f.fmt.pix_mp.plane_fmt[0].bytesperline != pitch) {
+      ALOGE("MDP3 rotation: S_FMT %ux%u pitch %u became %ux%u pitch %u", w, h,
+            pitch, f.fmt.pix_mp.width, f.fmt.pix_mp.height,
+            f.fmt.pix_mp.plane_fmt[0].bytesperline);
+      return false;
+    }
+    return true;
+  };
+  auto request = [fd](uint32_t type, uint32_t count) -> bool {
+    struct v4l2_requestbuffers rb {};
+    rb.type = type;
+    rb.memory = V4L2_MEMORY_DMABUF;
+    rb.count = count;
+    if (Xioctl(fd, VIDIOC_REQBUFS, &rb) != 0 || rb.count < count) {
+      ALOGE("MDP3 rotation: REQBUFS %u: %s", count, strerror(errno));
+      return false;
+    }
+    return true;
+  };
+
+  uint32_t type_out = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+  uint32_t type_cap = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+  if (!set_format(type_out, cfg.width, cfg.height, cfg.pitch) ||
+      !set_format(type_cap, out_w, out_h, st.targets[0].bi.pitches[0])) {
+    return false;
+  }
+  struct v4l2_control ctrl {
+    .id = V4L2_CID_ROTATE, .value = cfg.rotation
+  };
+  if (Xioctl(fd, VIDIOC_S_CTRL, &ctrl) != 0) {
+    ALOGE("MDP3 rotation: rotate %d: %s", cfg.rotation, strerror(errno));
+    return false;
+  }
+  if (!request(type_out, 1) || !request(type_cap, kTargets)) {
+    return false;
+  }
+  if (Xioctl(fd, VIDIOC_STREAMON, &type_out) != 0 ||
+      Xioctl(fd, VIDIOC_STREAMON, &type_cap) != 0) {
+    ALOGE("MDP3 rotation: STREAMON: %s", strerror(errno));
+    return false;
+  }
+  st.config = cfg;
+  ALOGI("MDP3 rotation: %ux%u pitch %u rotate %d", cfg.width, cfg.height,
+        cfg.pitch, cfg.rotation);
+  return true;
+}
+
+auto Mdp3Rotator::Run(State &st, const LayerData &layer, int target_index)
+    -> bool {
+  ATRACE_NAME("MDP3 rotate");
+  const int fd = *st.video;
+  const auto &bi = *layer.bi;
+  auto &target = st.targets[target_index];
+
+  if (layer.acquire_fence &&
+      !WaitFd(*layer.acquire_fence, POLLIN, kFenceTimeoutMs)) {
+    ALOGE("MDP3 rotation: acquire fence timed out");
+    return false;
+  }
+  const uint32_t src_size = bi.pitches[0] * bi.height;
+  struct v4l2_plane plane {};
+  struct v4l2_buffer buf {};
+  buf.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+  buf.memory = V4L2_MEMORY_DMABUF;
+  buf.index = 0;
+  buf.m.planes = &plane;
+  buf.length = 1;
+  plane.m.fd = bi.prime_fds[0];
+  plane.length = src_size;
+  plane.bytesused = src_size;
+  if (Xioctl(fd, VIDIOC_QBUF, &buf) != 0) {
+    ALOGE("MDP3 rotation: QBUF source: %s", strerror(errno));
+    return false;
+  }
+
+  plane = {};
+  buf = {};
+  buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+  buf.memory = V4L2_MEMORY_DMABUF;
+  buf.index = uint32_t(target_index);
+  buf.m.planes = &plane;
+  buf.length = 1;
+  plane.m.fd = *target.prime;
+  plane.length = target.bi.sizes[0];
+  if (Xioctl(fd, VIDIOC_QBUF, &buf) != 0) {
+    ALOGE("MDP3 rotation: QBUF target: %s", strerror(errno));
+    return false;
+  }
+
+  uint32_t flags = 0;
+  if (!Dequeue(fd, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE, POLLIN, &flags)) {
+    ALOGE("MDP3 rotation: no result within %d ms: %s", kJobTimeoutMs,
+          strerror(errno));
+    return false;
+  }
+  const bool failed = (flags & V4L2_BUF_FLAG_ERROR) != 0;
+  if (!Dequeue(fd, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE, POLLOUT, &flags)) {
+    ALOGE("MDP3 rotation: source not returned: %s", strerror(errno));
+    return false;
+  }
+  if (failed) {
+    ALOGE("MDP3 rotation: job failed");
+    return false;
+  }
+  return true;
+}
+
+void Mdp3Rotator::WorkerLoop() {
+  for (;;) {
+    State *st = nullptr;
+    {
+      std::unique_lock lock(mutex_);
+      cv_.wait(lock, [this] { return stop_ || !queue_.empty(); });
+      if (queue_.empty()) {
+        return;
+      }
+      st = queue_.front();
+      queue_.pop_front();
+    }
+    /* The job is not changed and the state is not freed until job_done. */
+    const double start = NowMs();
+    const bool ok = Run(*st, st->job->src, st->job->target);
+    const double took = NowMs() - start;
+    {
+      const std::lock_guard lock(mutex_);
+      st->job_done = true;
+      st->job_ok = ok;
+      run_ms_ += took;
+      if (++runs_ % kStatsEvery == 0) {
+        ALOGI("MDP3 rotation: %" PRIu64 " runs, avg %.2f ms, %" PRIu64
+              " reused, %" PRIu64 " presents waited",
+              runs_, run_ms_ / double(runs_), reused_, waits_);
+      }
+    }
+    cv_.notify_all();
+    /* Ask for a frame so the result is shown even if nothing else changes. */
+    if (ok && refresh_) {
+      refresh_();
+    }
+  }
+}
+
+void Mdp3Rotator::Collect(State &st) {
+  if (!st.job || !st.job_done) {
+    return;
+  }
+  if (st.job_ok) {
+    st.shown = st.job->target;
+    st.next = (st.shown + 1) % kTargets;
+    st.shown_fb = st.job->src.fb;
+    st.shown_fence = st.job->src.acquire_fence;
+  } else {
+    Disable("rotate");
+  }
+  st.job.reset();
+  st.job_done = false;
+}
+
+void Mdp3Rotator::WaitJob(std::unique_lock<std::mutex> &lock, State &st) {
+  if (!st.job || st.job_done) {
+    return;
+  }
+  ATRACE_NAME("MDP3 wait");
+  waits_++;
+  cv_.wait(lock, [&st] { return !st.job || st.job_done; });
+}
+
+void Mdp3Rotator::Disable(const char *why) {
+  ALOGE("MDP3 rotation off: %s failed. Rotated layers go to the GPU.", why);
+  disabled_ = true;
+}
+
+auto Mdp3Rotator::Substitute(const void *key, const LayerData &layer, bool run)
+    -> std::optional<LayerData> {
+  if (!Accepts(layer)) {
+    return std::nullopt;
+  }
+  const auto &bi = *layer.bi;
+  const int rotation = Rotation(layer.pi.transform);
+  const Config cfg{bi.width, bi.height, bi.pitches[0], bi.format, rotation};
+
+  std::unique_lock lock(mutex_);
+  auto &st = states_[key];
+  st.idle_frames = 0;
+  Collect(st);
+
+  if (!st.config || !(*st.config == cfg)) {
+    /* The context and targets are replaced; let a running job finish. */
+    WaitJob(lock, st);
+    Collect(st);
+    if (!Configure(st, cfg)) {
+      Disable("configure");
+      return std::nullopt;
+    }
+  }
+
+  if (run) {
+    const bool queued = st.job && SameSource(layer, st.job->src.fb,
+                                             st.job->src.acquire_fence);
+    const bool shown = st.shown >= 0 &&
+                       SameSource(layer, st.shown_fb, st.shown_fence);
+    if (shown) {
+      reused_++;
+    } else if (!queued) {
+      /* One job per layer. The previous source may only be released once
+       * its job has read it, which happens before this present returns. */
+      WaitJob(lock, st);
+      Collect(st);
+      if (disabled_) {
+        return std::nullopt;
+      }
+      st.job = Job{layer, st.next};
+      st.job_done = false;
+      queue_.push_back(&st);
+      cv_.notify_all();
+    }
+    if (st.shown < 0) {
+      /* Nothing rotated yet, so this first frame has to wait. */
+      WaitJob(lock, st);
+      Collect(st);
+      if (st.shown < 0) {
+        return std::nullopt;
+      }
+    }
+  }
+
+  /* A test commit before the first result only needs a buffer of the right
+   * size; targets[next] is that buffer. */
+  const auto &target = st.targets[st.shown >= 0 ? st.shown : st.next];
+  LayerData out;
+  out.bi = target.bi;
+  out.bi->blend_mode = bi.blend_mode;
+  out.bi->color_space = bi.color_space;
+  out.bi->sample_range = bi.sample_range;
+  out.fb = target.fb;
+  out.pi = RotatedInfo(layer, rotation);
+  return out;
+}
+
+void Mdp3Rotator::EndFrame() {
+  std::unique_lock lock(mutex_);
+  for (auto it = states_.begin(); it != states_.end();) {
+    Collect(it->second);
+    if (++it->second.idle_frames > kIdleFramesBeforeFree) {
+      WaitJob(lock, it->second);
+      it = states_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+}  // namespace android
