+
+namespace android {
+
+class DrmDevice;
+
+/*
+ * Rotates layers by 90 or 270 degrees with the MediaTek MDP3 V4L2 m2m device,
+ * for display planes that can only rotate by 0 or 180 degrees.
+ *
+ * Each rotated layer gets its own m2m context and three scanout buffers. The
+ * rotated copy replaces the layer in the KMS plan, with no transform left.
+ *
+ * Rotation runs on a worker thread, one frame ahead of scanout: a present
+ * that brings a new buffer queues a job and shows the last finished result.
+ * When a job finishes, the client is asked for another frame so the newest
+ * result reaches the screen even if the layer stops changing.
+ */
+class Mdp3Rotator {
+ public:
+  static auto Create(DrmDevice &drm, std::function<void()> refresh)
+      -> std::unique_ptr<Mdp3Rotator>;
+
+  ~Mdp3Rotator();
+  Mdp3Rotator(const Mdp3Rotator &) = delete;
+  Mdp3Rotator &operator=(const Mdp3Rotator &) = delete;
+
+  /* Whether the layer is a 90 or 270 degree rotation this class can do. */
+  auto Accepts(const LayerData &layer) const -> bool;
+
+  /*
+   * Returns the layer as it looks after rotation. With run == false (a test
+   * commit) nothing is queued. With run == true a new source buffer is
+   * queued for rotation. nullopt means the rotation failed. The rotator then
+   * turns itself off.
+   */
+  auto Substitute(const void *key, const LayerData &layer, bool run)
+      -> std::optional<LayerData>;
+
+  /* Call after each real commit. Frees layers that are no longer rotated. */
+  void EndFrame();
+
+ private:
+  static constexpr int kTargets = 3;
+
+  struct Target {
+    UniqueFd prime = MakeUniqueFd(-1);
+    BufferInfo bi{};
+    std::shared_ptr<DrmFbIdHandle> fb;
+  };
+
+  struct Config {
+    uint32_t width;
+    uint32_t height;
+    uint32_t pitch;
+    uint32_t format;
+    int rotation;
+    bool operator==(const Config &o) const {
+      return width == o.width && height == o.height && pitch == o.pitch &&
+             format == o.format && rotation == o.rotation;
+    }
+  };
+
+  struct Job {
+    LayerData src;
+    int target;
+  };
+
+  struct State {
+    std::optional<Config> config;
+    UniqueFd video = MakeUniqueFd(-1);
+    std::array<Target, kTargets> targets;
+    int next = 0;
+    int shown = -1;
+    /* Source of the result in targets[shown]. */
+    std::shared_ptr<DrmFbIdHandle> shown_fb;
+    SharedFd shown_fence;
+    /* Queued or running job. Only the worker touches video and the target
+     * while job is set and job_done is false. */
+    std::optional<Job> job;
+    bool job_done = false;
+    bool job_ok = false;
+    int idle_frames = 0;
+  };
+
+  Mdp3Rotator(DrmDevice &drm, std::string path, std::function<void()> refresh);
+
+  static auto Rotation(const LayerTransform &t) -> int;
+  static auto RotatedInfo(const LayerData &layer, int rotation) -> PresentInfo;
+  static auto SameSource(const LayerData &layer,
+                         const std::shared_ptr<DrmFbIdHandle> &fb,
+                         const SharedFd &fence) -> bool;
+
+  auto Configure(State &st, const Config &cfg) -> bool;
+  auto AllocTarget(Target &t, uint32_t width, uint32_t height,
+                   uint32_t format) -> bool;
+  auto Run(State &st, const LayerData &layer, int target) -> bool;
+  void Disable(const char *why);
+
+  /* These expect mutex_ to be held. */
+  void Collect(State &st);
+  void WaitJob(std::unique_lock<std::mutex> &lock, State &st);
+
+  void WorkerLoop();
+
+  DrmDevice &drm_;
+  const std::string path_;
+  const std::function<void()> refresh_;
+
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  std::deque<State *> queue_;
+  bool stop_ = false;
+  std::map<const void *, State> states_;
+  std::atomic<bool> disabled_ = false;
+  std::thread worker_;
+
+  /* Statistics, under mutex_. */
+  uint64_t runs_ = 0;
+  uint64_t reused_ = 0;
+  uint64_t waits_ = 0;
+  double run_ms_ = 0;
+};
+
+}  // namespace android
