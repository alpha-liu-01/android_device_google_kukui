+constexpr const char *kMdp3Name = "mtk-mdp3:m2m";
+constexpr int kFenceTimeoutMs = 1000;
+constexpr int kJobTimeoutMs = 500;
+constexpr int kIdleFramesBeforeFree = 120;
+constexpr uint32_t kMinSize = 16;
+constexpr uint32_t kMaxSize = 4096;
+constexpr uint64_t kStatsEvery = 600;
+
+auto NowMs() -> double {
+  struct timespec ts {};
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return double(ts.tv_sec) * 1e3 + double(ts.tv_nsec) / 1e6;
+}
+
+auto Xioctl(int fd, unsigned long req, void *arg) -> int {
+  int ret = 0;
+  do {
+    ret = ioctl(fd, req, arg);
+  } while (ret < 0 && errno == EINTR);
+  return ret;
+}
+
+auto FindMdp3Node() -> std::string {
+  DIR *dir = opendir("/sys/class/video4linux");
+  if (dir == nullptr) {
+    return {};
+  }
+  std::string found;
+  while (struct dirent *ent = readdir(dir)) {
+    if (strncmp(ent->d_name, "video", 5) != 0) {
+      continue;
+    }
+    std::ifstream name_file(std::string("/sys/class/video4linux/") +
+                            ent->d_name + "/name");
+    std::string name;
+    std::getline(name_file, name);
+    if (name == kMdp3Name) {
+      found = std::string("/dev/") + ent->d_name;
+      break;
+    }
+  }
+  closedir(dir);
+  return found;
+}
+
+/* Waits until fd is readable (POLLIN) or writable (POLLOUT). */
+auto WaitFd(int fd, short events, int timeout_ms) -> bool {
+  struct pollfd pfd {
+    .fd = fd, .events = events, .revents = 0
+  };
+  int ret = 0;
+  do {
+    ret = poll(&pfd, 1, timeout_ms);
+  } while (ret < 0 && errno == EINTR);
+  return ret > 0 && (pfd.revents & events) != 0;
+}
+
+/* Dequeues one buffer of the given queue, waiting up to the job timeout. */
+auto Dequeue(int fd, uint32_t type, short events, uint32_t *flags) -> bool {
+  for (int tries = 0; tries < 2; tries++) {
+    struct v4l2_plane plane {};
+    struct v4l2_buffer buf {};
+    buf.type = type;
+    buf.memory = V4L2_MEMORY_DMABUF;
+    buf.m.planes = &plane;
+    buf.length = 1;
+    if (Xioctl(fd, VIDIOC_DQBUF, &buf) == 0) {
+      *flags = buf.flags;
+      return true;
+    }
+    if (errno != EAGAIN || !WaitFd(fd, events, kJobTimeoutMs)) {
+      return false;
+    }
+  }
+  return false;
+}
