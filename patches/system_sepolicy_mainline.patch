diff --git a/private/coredomain.te b/private/coredomain.te
index 2163c51..4ff9051 100644
--- a/private/coredomain.te
+++ b/private/coredomain.te
@@ -148,6 +148,16 @@ full_treble_only(`
   } proc:file no_rw_file_perms;
 
   # /sys
+  # libdrm in surfaceflinger reads .../display-subsystem/uevent. That inode
+  # is created before the policy is loaded and stays type sysfs, so the
+  # genfscon for sysfs_gpu does not apply to it. Read stays allowed for
+  # surfaceflinger. Write does not.
+  # system_suspend reads wakeup counters through /sys/class/wakeup, which
+  # is a symlink into device directories that stay type sysfs.
+  # system_server InputReader reads the input device name and keyboard
+  # country the same way. Write stays forbidden.
+  # stylusctrl reads /sys/class/input to identify the builtin pen.
+  # Those inodes stay type sysfs. Write stays forbidden.
   neverallow {
     coredomain
     -apexd
@@ -155,14 +165,29 @@ full_treble_only(`
     -ueventd
     is_flag_enabled(RELEASE_AVF_ENABLE_DEVICE_ASSIGNMENT, `-vfio_handler')
     -vold
-  } sysfs:file no_rw_file_perms;
+  } sysfs:file no_w_file_perms;
+  neverallow {
+    coredomain
+    -apexd
+    -init
+    -ueventd
+    -surfaceflinger
+    -system_suspend
+    -system_server
+    -stylusctrl
+    is_flag_enabled(RELEASE_AVF_ENABLE_DEVICE_ASSIGNMENT, `-vfio_handler')
+    -vold
+  } sysfs:file { open read ioctl lock watch watch_mount watch_sb watch_with_perm watch_reads };
 
   # /dev
+  # kernel is exempt because this 6.6 kernel uses devtmpfs. kdevtmpfs creates
+  # loop and dm nodes after the policy is loaded; ueventd restorecon relabels them.
   neverallow {
     coredomain
     -apexd
     -fsck
     -init
+    -kernel
     -ueventd
   } device:{ blk_file file } no_rw_file_perms;
 
