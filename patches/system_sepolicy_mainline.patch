diff --git a/private/stylusctrl.te b/private/stylusctrl.te
new file mode 100644
index 0000000..74cb03a
--- /dev/null
+++ b/private/stylusctrl.te
@@ -0,0 +1,34 @@
+# Builtin pen. The settings app writes config.json in its own files dir.
+# This domain reads that file, grabs the i2c-hid pen, and creates the
+# replacement device on /dev/uinput.
+type stylusctrl, domain, coredomain;
+# /data/user/0 is system_data_file at s0:c512,c768. An s0 domain does not
+# dominate that level, so directory search fails without this attribute.
+typeattribute stylusctrl mlstrustedsubject;
+
+dontaudit stylusctrl adb_data_file:dir search;
+dontaudit stylusctrl shell_data_file:dir search;
+type stylusctrl_exec, system_file_type, exec_type, file_type;
+
+init_daemon_domain(stylusctrl)
+
+allow stylusctrl input_device:dir r_dir_perms;
+allow stylusctrl input_device:chr_file rw_file_perms;
+allow stylusctrl uhid_device:chr_file rw_file_perms;
+
+# External pen second button is HID Invert on /dev/hidrawN.
+allow stylusctrl hidraw_device:chr_file r_file_perms;
+
+# /sys/class/input/eventN is a symlink into a device directory that stays
+# type sysfs. coredomain.te exempts the read. Write stays forbidden.
+allow stylusctrl sysfs:dir r_dir_perms;
+allow stylusctrl sysfs:file r_file_perms;
+allow stylusctrl sysfs:lnk_file r_file_perms;
+
+allow stylusctrl system_data_file:dir search;
+allow stylusctrl system_data_file:lnk_file read;
+allow stylusctrl app_data_file:dir { search getattr };
+allow stylusctrl app_data_file:file { getattr open read };
+
+# The init service uses stdio_to_kmsg.
+allow stylusctrl kmsg_debug_device:chr_file w_file_perms;
