import /vendor/etc/init/hw/init.mainline.rc

on early-boot
    # The lineage light HAL runs as system and writes this node. The stock
    # rc only chowns backlight and panel0-backlight. This panel is
    # backlight_lcd0, so the node stayed root:root and the slider never
    # landed. Repeated on boot in case the platform device appears later.
    chown system system /sys/class/backlight/backlight_lcd0/brightness

on boot
    chown system system /sys/class/backlight/backlight_lcd0/brightness

on early-init
    write /sys/module/firmware_class/parameters/path /vendor/firmware
    # The camera HAL's IPA worker is a vendor binary. The library looks
    # here before its compiled /vendor/libexec path.
    export LIBCAMERA_IPA_PROXY_PATH /vendor/bin/libcamera
    setprop vendor.usb.configfs 0
    # Apps load vulkan.panfrost.so. The compositor stays on GLES: the
    # shadow pass on this Mali-G72 already misses 60 Hz.
    # Mesa hides Bifrost panvk unless this is set. G72 is that generation.
    export PAN_I_WANT_A_BROKEN_VULKAN_DRIVER 1
    setprop debug.renderengine.backend skiaglthreaded
    setprop debug.hwui.renderer skiagl
    # The panel scans out portrait and the UI is landscape (ORIENTATION_270).
    # The OVL planes cannot rotate by 90, and HWUI's GL path does not
    # pre-rotate on its own, so every layer went to GPU composition. With
    # patches/frameworks_base_hwui_gl_prerotation.patch applied, this makes
    # apps render in panel orientation so drm_hwcomposer can scan them out.
    # skiavk would pre-rotate too, but HWUI needs Vulkan 1.1 and panvk on
    # Bifrost reports 1.0.
    setprop debug.hwui.gl_prerotation true
    # SurfaceFlinger primes its shader cache again (the AOSP default). In
    # the early bring-up the RenderEngine thread aborted while priming,
    # so it was off; on 6.18.63 with the current Mesa it compiles 93
    # shaders in about 4 s on that thread and the first GPU-composited
    # animation no longer stalls on shader compiles.
    # Desktop window shadows are drawn by the GPU. On Mali-G72 that pass
    # takes about 24 ms, so a 60 Hz panel presents every other vsync and
    # the whole screen, including menus, runs at about 30 fps. The panel
    # has no second refresh rate. Skipping the shadow keeps composition
    # under a frame.
    setprop persist.wm.debug.desktop_use_window_shadows false

on init
    # dlkm_loader starts from a later on-init and reads
    # /vendor/lib/modules/modules.load. The firmware path has to be set
    # before ath10k probes. The post-fs insmod block never ran.
    write /sys/module/firmware_class/parameters/path /vendor/firmware

# prng_seeder starts in early-init and gives up for good ("Hanging forever")
# when /dev/hw_random has no source. The source is the Cr50 TPM, and
# tpm_tis_spi only loads from vendor_dlkm afterwards. Start it again once
# dlkm_loader_mainline has loaded the modules.
on property:vendor.dlkm.modules.ready=true
    restart prng_seeder
    start kukui-ids

on boot
    # ondemand ramps up only at 95% load and does not count I/O wait.
    # 80% with io_is_busy cut app launches by 7-16% on Krane with no
    # change in scroll jank. Touch and launch boosts are in the power HAL
    # (power/powerhint.json).
    write /sys/devices/system/cpu/cpufreq/policy0/ondemand/up_threshold 80
    write /sys/devices/system/cpu/cpufreq/policy4/ondemand/up_threshold 80
    write /sys/devices/system/cpu/cpufreq/policy0/ondemand/io_is_busy 1
    write /sys/devices/system/cpu/cpufreq/policy4/ondemand/io_is_busy 1
    # Background work on the four Cortex-A53 cores (0-3); the foreground
    # and top app keep all eight, including the Cortex-A73 cores (4-7).
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3

on boot
    # Bring-up: name the wakeup source when a suspend is aborted (the
    # occasional -16 at the freeze step) and log the WoW suspend path.
    # Needs CONFIG_PM_SLEEP_DEBUG. Remove once suspend is settled.
    write /sys/power/pm_debug_messages 1

on fs
    # keymint is up before early_hal starts keystore2. userdata is not
    # metadata-encrypted, so mount_all does not call encryptFstab.
    start vendor.keymint-default
    # No --late. These entries are not latemount, so --late mounts nothing
    # and leaves the empty userdata and metadata partitions unformatted.
    mount_all /vendor/etc/fstab.${ro.hardware}
    swapon_all /vendor/etc/fstab.${ro.hardware}

on post-fs
    # keystore2 is early_hal, which runs before the platform mkdir in
    # post-fs-data. It aborts when this directory is missing.
    mkdir /data/misc 01771 system misc
    mkdir /data/misc/keystore 0700 keystore keystore
    write /sys/class/vtconsole/vtcon0/bind 0
    write /sys/class/vtconsole/vtcon1/bind 0

on post-fs-data
    # FBE is off. tombstoned still only writes here, and the tenth boot
    # left this directory empty.
    mkdir /data/tombstones 0775 system system
    mkdir /data/anr 0775 system system
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi
    start kukui-usb-suspend

on property:sys.boot_completed=1
    start kukui-wifi-reprobe
    start kukui-lid

service kukui-usb-suspend /system/bin/sh /vendor/bin/kukui-usb-suspend.sh
    disabled
    user root
    group root system
    oneshot

# The ramdisk init starts the same script. This service covers a super
# image that has the script but an older ramdisk. The script's lock
# directory makes the second start exit.
service kukui-wifi-reprobe /system/bin/sh /vendor/bin/kukui-wifi-reprobe.sh
    disabled
    user root
    group root
    oneshot

# Existing data partitions already stored lid_behavior=0. The overlay
# default applies only when settings are created.
service kukui-lid /system/bin/sh /vendor/bin/kukui-lid.sh
    disabled
    user root
    group root system
    oneshot

# Serial number from the VPD and the board revision from coreboot, for
# Settings > About > Model. Needs vpd-sysfs, so it waits for the modules.
service kukui-ids /system/bin/sh /vendor/bin/kukui-ids.sh
    disabled
    user root
    group root system
    oneshot
