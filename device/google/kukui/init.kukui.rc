import /vendor/etc/init/hw/init.mainline.rc

on early-init
    write /sys/module/firmware_class/parameters/path /vendor/firmware
    setprop vendor.usb.configfs 0
    setprop debug.renderengine.backend skiaglthreaded
    setprop debug.hwui.renderer skiagl
    # The tenth boot got past HWC hotplug (ctl.start bootanim) and then
    # SIGABRT about 160ms later, on the RenderEngine thread. That thread
    # is priming the shader cache. Skip it so the first frames are the
    # ones bootanim actually needs. If something else still aborts, the
    # message is in kmsg via kukui-logcat.
    setprop service.sf.prime_shader_cache false

on init
    write /sys/block/zram0/comp_algorithm zstd

on fs
    # kukui-keep still holds pmOS_boot, so a second mount returns EBUSY.
    # The kmsg file is the log. keymint is up before early_hal starts
    # keystore2. userdata is not metadata-encrypted, so mount_all does
    # not call encryptFstab.
    start vendor.keymint-default
    # No --late. These entries are not latemount, so --late mounts nothing
    # and leaves the empty userdata and metadata partitions unformatted.
    mount_all /vendor/etc/fstab.${ro.hardware}
    swapon_all /vendor/etc/fstab.${ro.hardware}

on post-fs
    # vendor_dlkm is first_stage_mount, so the modules are already
    # reachable. /vendor/lib/modules is a symlink to that directory.
    # Repeat the firmware path here: ath10k probes during insmod, and
    # the direct loader looks at this parameter before ueventd.
    write /sys/module/firmware_class/parameters/path /vendor/firmware
    insmod /vendor_dlkm/lib/modules/rfkill.ko
    insmod /vendor_dlkm/lib/modules/cfg80211.ko
    insmod /vendor_dlkm/lib/modules/libarc4.ko
    insmod /vendor_dlkm/lib/modules/mac80211.ko
    insmod /vendor_dlkm/lib/modules/ath.ko
    insmod /vendor_dlkm/lib/modules/ath10k_core.ko
    insmod /vendor_dlkm/lib/modules/ath10k_sdio.ko
    # keystore2 is early_hal, which runs before the platform mkdir in
    # post-fs-data. It aborts when this directory is missing.
    mkdir /data/misc 01771 system misc
    mkdir /data/misc/keystore 0700 keystore keystore
    write /sys/class/vtconsole/vtcon0/bind 0
    write /sys/class/vtconsole/vtcon1/bind 0

on post-fs-data
    # FBE is off. tombstoned still only writes here, and the tenth boot
    # left this directory empty. kukui-logcat does not depend on it.
    mkdir /data/tombstones 0775 system system
    mkdir /data/anr 0775 system system
    start kukui-logcat

service kukui-logcat /system/bin/sh /vendor/bin/kukui-logcat.sh
    disabled
    user root
    group root system log readproc
    oneshot
