package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "KukuiInstall",
    srcs: [
        "src/**/*.java",
    ],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    min_sdk_version: "34",
    certificate: "platform",
    system_ext_specific: true,
    static_libs: ["com.google.android.material_material"],
}

sh_binary {
    name: "kukui-installd",
    src: "kukui-installd.sh",
    vendor: true,
}
