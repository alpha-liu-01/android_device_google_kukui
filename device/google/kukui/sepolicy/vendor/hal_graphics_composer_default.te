# drm_hwcomposer rotates 90 and 270 degree layers with the MDP3 V4L2 m2m
# node. It finds the node by name under /sys/class/video4linux.
allow hal_graphics_composer_default video_device:chr_file rw_file_perms;
allow hal_graphics_composer_default sysfs_v4l:dir r_dir_perms;
allow hal_graphics_composer_default sysfs_v4l:file r_file_perms;
# Nodes that exist before policy load stay type sysfs.
allow hal_graphics_composer_default sysfs:dir r_dir_perms;
allow hal_graphics_composer_default sysfs:file r_file_perms;
