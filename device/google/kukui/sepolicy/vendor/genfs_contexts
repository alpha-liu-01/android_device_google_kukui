# Krane sysfs paths. The mainline policy labels the /class/* symlinks, but
# the HALs open the real /devices/... paths, which stayed plain sysfs.

# Battery behind the EC I2C tunnel and the USB-PD charger (health HAL)
genfscon sysfs /devices/platform/soc/11012000.spi/spi_master/spi2/spi2.0/11012000.spi:cros-ec@0:i2c-tunnel/i2c-12/12-000b/power_supply u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/soc/11012000.spi/spi_master/spi2/spi2.0/cros-ec-dev.1.auto/cros-usbpd-charger.9.auto/power_supply u:object_r:sysfs_batteryinfo:s0

# Stylus battery that the Goodix touch controller reports (sku176 0E31,
# sku0 0E30). InputManager in system_server reads it, and platform
# domains must not read sysfs_batteryinfo.
genfscon sysfs /devices/platform/soc/11007000.i2c/i2c-0/0-005d/0018:27C6:0E31.0001/power_supply u:object_r:vendor_sysfs_stylus_battery:s0
genfscon sysfs /devices/platform/soc/11007000.i2c/i2c-0/0-005d/0018:27C6:0E30.0001/power_supply u:object_r:vendor_sysfs_stylus_battery:s0

# Panel backlight (light HAL)
genfscon sysfs /devices/platform/backlight_lcd0/backlight u:object_r:vendor_sysfs_backlight:s0

# EC sensors: accelerometer, gyroscope, light (sensor HAL)
genfscon sysfs /devices/platform/soc/11012000.spi/spi_master/spi2/spi2.0/cros-ec-dev.1.auto/cros-ec-sensorhub.2.auto u:object_r:vendor_sysfs_iio:s0

# Wi-Fi interface attributes (netd sets the MTU)
genfscon sysfs /devices/platform/soc/11240000.mmc/mmc_host/mmc1/mmc1:0001/mmc1:0001:1/net u:object_r:sysfs_net:s0

# Other IIO devices. The sensor HAL lists /sys/bus/iio/devices.
genfscon sysfs /bus/iio/devices u:object_r:vendor_sysfs_iio:s0
genfscon sysfs /devices/platform/soc/1000d000.pwrap/1000d000.pwrap:pmic/mt6359-auxadc/iio:device u:object_r:vendor_sysfs_iio:s0
genfscon sysfs /devices/platform/soc/11001000.auxadc/iio:device u:object_r:vendor_sysfs_iio:s0
genfscon sysfs /devices/platform/thermal-sensor1/iio:device u:object_r:vendor_sysfs_iio:s0
genfscon sysfs /devices/platform/thermal-sensor2/iio:device u:object_r:vendor_sysfs_iio:s0

# Wakeup sources behind /sys/class/wakeup.
genfscon sysfs /devices/platform/soc/11012000.spi/spi_master/spi2/spi2.0/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11012000.spi/spi_master/spi2/spi2.0/11012000.spi:cros-ec@0:cbas/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11012000.spi/spi_master/spi2/spi2.0/11012000.spi:cros-ec@0:keyboard-controller/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11012000.spi/spi_master/spi2/spi2.0/11012000.spi:cros-ec@0:i2c-tunnel/i2c-12/12-000b/power_supply/sbs-12-000b/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11007000.i2c/i2c-0/0-005d/0018:27C6:0E31.0001/power_supply/hid-0018:27C6:0E31.0001-battery/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11007000.i2c/i2c-0/0-005d/0018:27C6:0E30.0001/power_supply/hid-0018:27C6:0E30.0001-battery/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/1000d000.pwrap/1000d000.pwrap:pmic/mt6358-rtc/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/1000d000.pwrap/1000d000.pwrap:pmic/mt6358-rtc/rtc/rtc0/alarmtimer u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11201000.usb/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11201000.usb/11200000.usb/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11240000.mmc/mmc_host/mmc1/mmc1:0001/mmc1:0001:1/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/wifi-wakeup/wakeup u:object_r:sysfs_wakeup:s0

# USB connector state from the EC.
genfscon sysfs /devices/platform/soc/11012000.spi/spi_master/spi2/spi2.0/11012000.spi:cros-ec@0:extcon0/extcon u:object_r:sysfs_extcon:s0

# Panfrost devfreq: the power HAL writes min_freq and max_freq.
genfscon sysfs /devices/platform/soc/13040000.gpu/devfreq u:object_r:vendor_sysfs_gpu_devfreq:s0

# libdrm reads the uevent of the DRM devices. The instance number is the
# probe order on this kernel.
genfscon sysfs /devices/platform/soc/13040000.gpu/uevent u:object_r:sysfs_gpu:s0
genfscon sysfs /devices/platform/soc/14000000.syscon/mediatek-drm.17.auto/uevent u:object_r:sysfs_gpu:s0
