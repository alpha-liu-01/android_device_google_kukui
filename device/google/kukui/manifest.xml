<manifest version="8.0" type="device" target-level="202604">
    <!-- This file must exist so VINTF loads vendor and APEX fragments.
         KeyMint and Gatekeeper come from their APEXes. USB gadget is off,
         so the HIDL manager entries are not declared.
         The audio APEX leaves IModule/usb commented out. servicemanager
         rejects the instance unless this manifest declares it. -->
    <hal format="aidl">
        <name>android.hardware.audio.core</name>
        <version>4</version>
        <fqname>IModule/usb</fqname>
    </hal>
</manifest>
