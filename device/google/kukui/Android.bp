package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "kukui-keep",
    srcs: ["kukui-keep.c"],
    static_executable: true,
    stl: "none",
    system_shared_libs: [],
    static_libs: ["libc"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_prebuilt_library_shared {
    name: "libcamera-base",
    vendor: true,
    compile_multilib: "64",
    srcs: ["camera/prebuilt/libcamera-base.so"],
    check_elf_files: false,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "libcamera",
    prefer: true,
    vendor: true,
    compile_multilib: "64",
    srcs: ["camera/prebuilt/libcamera.so"],
    shared_libs: ["libcamera-base"],
    check_elf_files: false,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "camera.libcamera",
    prefer: true,
    vendor: true,
    compile_multilib: "64",
    relative_install_path: "hw",
    srcs: ["camera/prebuilt/camera.libcamera.so"],
    shared_libs: [
        "libcamera",
        "libcamera-base",
        "libexif",
        "libhardware",
        "libjpeg",
        "libyuv",
    ],
    check_elf_files: false,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "ipa_soft_simple",
    vendor: true,
    compile_multilib: "64",
    relative_install_path: "libcamera/ipa",
    srcs: ["camera/prebuilt/ipa_soft_simple.so"],
    shared_libs: [
        "libcamera",
        "libcamera-base",
    ],
    check_elf_files: false,
    strip: {
        none: true,
    },
}

cc_prebuilt_binary {
    name: "libcamera_soft_ipa_proxy",
    stem: "soft_ipa_proxy",
    vendor: true,
    srcs: ["camera/prebuilt/soft_ipa_proxy"],
    relative_install_path: "libcamera",
    shared_libs: [
        "libcamera",
        "libcamera-base",
    ],
    check_elf_files: false,
    strip: {
        none: true,
    },
}
