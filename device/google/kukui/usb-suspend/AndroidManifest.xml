<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.kukui.usbsuspend"
    android:sharedUserId="android.uid.system">

    <application
        android:label="@string/title"
        android:theme="@style/Theme.KukuiUsbSuspend">
        <!-- Settings loads IA_SETTINGS providers after setup, and only from
             system packages. The switch itself is the row on System. -->
        <provider
            android:name=".UsbSuspendSettings"
            android:authorities="org.kukui.usbsuspend"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
        </provider>

        <activity
            android:name=".UsbSuspendActivity"
            android:exported="false"
            android:label="@string/title" />
    </application>
</manifest>
